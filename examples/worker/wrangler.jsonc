{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connecta-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Plain vars. Secrets (SUPPORT_TOKEN, EXEC_TOKEN, CLERK_SECRET_KEY,
  // DOWNSTREAM_TOKEN) are set with `wrangler secret put <NAME>`, not here.
  "vars": {
    "PUBLIC_URL": "https://connecta.example.workers.dev",
    "CLERK_PUBLISHABLE_KEY": "pk_test_replace-me"
  },

  // Create with `wrangler kv namespace create CONNECTA_KV` and paste the id.
  "kv_namespaces": [
    { "binding": "CONNECTA_KV", "id": "replace-with-kv-namespace-id" }
  ],

  // Credential health (issue #24): a cron trigger runs the liveness checks over
  // stored downstream credentials, so a revoked token shows up as auth_required
  // before an agent's call hits it. Every 15 minutes matches the default
  // per-connector interval; the checks are rate-limited either way, so a tighter
  // cron does not multiply downstream requests. Delete this block to rely only
  // on the opportunistic checks inbound traffic already triggers.
  "triggers": { "crons": ["*/15 * * * *"] }

  // Optional paid code mode: add a comma above, then uncomment this binding.
  // Its presence is the entire switch — src/index.ts detects env.LOADER and
  // registers execute_code automatically. Leave it absent for a free-tier
  // deployment with the nine base meta-tools.
  // "worker_loaders": [{ "binding": "LOADER" }]
}
