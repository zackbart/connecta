{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connecta-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "observability": { "enabled": true },

  // Plain vars. Secrets (CREDENTIAL_ENCRYPTION_KEY, DOWNSTREAM_TOKEN) are set with
  // `wrangler secret put <NAME>`, not here.
  "vars": {
    "PUBLIC_URL": "https://connecta.example.workers.dev"
  },

  // Local-only Access identity. Remove this block to exercise the
  // unauthenticated path in `wrangler dev`; production identity comes from the
  // Worker-level Access application, not from this file.
  "access": {
    "dev": {
      "aud": "connecta-local",
      "identity": { "email": "operator@example.com" }
    }
  },

  // Create with `wrangler kv namespace create CONNECTA_KV` and paste the id.
  "kv_namespaces": [
    { "binding": "CONNECTA_KV", "id": "replace-with-kv-namespace-id" }
  ],

  // D1 databases, off by default so this example deploys without one.
  // Uncomment the array and keep the entries you use.
  //
  // ACTIVITY_DB: activity history. Create with `wrangler d1 create
  // connecta-activity`, paste the id, apply the schema in README.md, then
  // uncomment the matching lines in src/index.ts.
  //
  // STORAGE_DB: strongly consistent storage with compare-and-set, in place of
  // CONNECTA_KV. Create with `wrangler d1 create connecta-storage`, paste the
  // id, apply the schema in README.md § "Strongly consistent storage", then
  // pass `d1Storage(env.STORAGE_DB)` as `storage` in src/index.ts.
  // "d1_databases": [
  //   {
  //     "binding": "ACTIVITY_DB",
  //     "database_name": "connecta-activity",
  //     "database_id": "replace-with-d1-database-id"
  //   },
  //   {
  //     "binding": "STORAGE_DB",
  //     "database_name": "connecta-storage",
  //     "database_id": "replace-with-d1-database-id"
  //   }
  // ],

  // Required by execute_code; Dynamic Workers use the Workers Paid plan.
  "worker_loaders": [{ "binding": "LOADER" }]
}
