// Local development only: `wrangler dev` runs this Worker with local D1 and a
// simulated Access identity. Deploy with alchemy.run.ts, never with this file,
// and keep its vars, flags, and bindings in step with that stack.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connecta-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "unhandled_rejection_after_microtask_checkpoint"],
  "observability": { "enabled": true },

  // Plain vars. Local secrets (CREDENTIAL_ENCRYPTION_KEY, DOWNSTREAM_TOKEN) go
  // in an uncommitted .dev.vars file; deployed ones are declared in
  // alchemy.run.ts.
  // CONNECTA_ACTIVITY switches on activity history in src/connecta.config.ts
  // when "on"; its data stays in CONNECTA_DB.
  "vars": {
    // "CONNECTA_ACTIVITY": "on",
    "PUBLIC_URL": "https://connecta.example.workers.dev",
    // Comma-separated Access user ids (user_uuid, else email) of the
    // maintainers. This one matches the local dev identity below.
    "CONNECTA_MAINTAINERS": "operator@example.com",
  },

  // Local-only Access identity (Wrangler 4.123.0 or later). Remove this block to exercise the
  // unauthenticated path in `wrangler dev`; production identity comes from the
  // Worker-level Access application, not from this file.
  "access": {
    "dev": {
      "aud": "connecta-local",
      "identity": { "email": "operator@example.com" },
    },
  },

  // The one database, local under `wrangler dev`; alchemy.run.ts creates the
  // deployed one. connecta creates its tables on first use; nothing to apply.
  "d1_databases": [
    {
      "binding": "CONNECTA_DB",
      "database_name": "connecta",
      "database_id": "replace-with-d1-database-id",
    },
  ],

  // Required by execute_code; Dynamic Workers use the Workers Paid plan.
  "worker_loaders": [{ "binding": "LOADER" }],
}
