# connecta — Docker environment. Copy to `.env` and edit.
#   cp examples/docker/.env.example examples/docker/.env

# --- Server -----------------------------------------------------------------
# Listen port inside the container (also map it in docker-compose.yml).
PORT=8787
# fileStorage path — keep it under /data so it lands on the named volume.
STATE_FILE=/data/connecta-state.json
# Public origin of this deployment. Required for downstream-OAuth callbacks
# (/oauth/callback/<connectorId>) when exposing connecta. e.g. https://mcp.example.com
PUBLIC_URL=

# --- Inbound auth (configure at least one, or set CONNECTA_ALLOW_OPEN=1) -----
# Static bearer token. Clients send `Authorization: Bearer <this>`.
CONNECTA_TOKEN=

# Clerk OAuth (resource-server). BOTH keys must be set to enable it.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set to 1 to allow starting with NO inbound auth (OPEN endpoint, dev only).
# Leave blank in any real deployment.
CONNECTA_ALLOW_OPEN=
