          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Path below /api/v1 beginning with '/', such as /charges-list or /refunds/ch_123. No query string."
          },
          "query": {
            "type": "array",
            "maxItems": 50,
            "description": "Query parameters as name/value pairs, e.g. account_id.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Tithe.ly's snake_case parameter name."
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ],
                  "description": "Parameter value; stringified once by the transport."
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "form": {
            "type": "array",
            "maxItems": 50,
            "description": "Form fields as name/value pairs, sent form-encoded as Tithe.ly's documented examples send them. Amounts are integer cents.",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Tithe.ly's snake_case parameter name."
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ],
                  "description": "Field value; stringified once by the transport."
                }
              },
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "method",
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "description": "Tithe.ly's response body, less the sensitive fields this connection drops, or null when empty."
          }
        },
        "required": [
          "result"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true
      }
