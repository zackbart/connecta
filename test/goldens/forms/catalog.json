    {
      "name": "forms_api_search",
      "description": "Find Google Forms API operations by keyword or path. Returns up to 8 compact matches with the tool that calls each; reads no account data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Keywords or a path, e.g. refund charge."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "DELETE"
            ],
            "description": "Only operations with this method."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "Most operations to return.",
            "default": 6
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "page.nextCursor from the previous search with the same query."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
