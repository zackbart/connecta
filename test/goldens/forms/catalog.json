                              "type": "string"
                            },
                            "mimeType": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "score": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string",
                            "enum": [
                              "Infinity",
                              "-Infinity",
                              "NaN"
                            ]
