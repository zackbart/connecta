            "maxLength": 20000,
            "description": "New description; empty clears, omission preserves."
          },
          "requiredRevisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Current revisionId from a read or preceding edit; re-read and rebuild after conflict.",
