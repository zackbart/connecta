                  "type": "boolean"
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "questionId": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      },
                      "rowTitle": {
                        "type": "string"
                      },
