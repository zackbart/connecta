                    "properties": {
                      "questionId": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "values": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "files": {
                        "type": "array",
                        "items": {
