    {
      "name": "breeze_api_search",
      "description": "Find Breeze ChMS API operations by keyword or path. Returns up to 8 compact matches with routing and separate refusal reasons; reads no account data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Keywords or a path, e.g. refund charge."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET"
            ],
            "description": "Only operations with this method."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "description": "Most operations to return.",
            "default": 6
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "page.nextCursor from the previous search with the same query."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "GET"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "operationId": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "refusal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "Reviewed refusal, capped separately from summary. A cut reason is marked in truncated; details returns it whole."
                },
                "tool": {
                  "type": "string",
                  "description": "The tool that calls it; absent when refused."
                },
                "named": {
                  "type": "string",
                  "description": "A named tool serving this operation with a projected result; prefer it."
                },
                "matched": {
                  "type": "string",
                  "description": "The request or response field this operation was found by; call its tool to read the field."
                }
              },
              "required": [
                "method",
                "path",
                "operationId",
                "summary"
              ]
            }
          },
          "revision": {
            "type": "string",
            "description": "Operation index revision."
          },
          "truncated": {
            "type": "array",
            "description": "Entry labels cut for size; breeze_api_details on that method and path returns them whole.",
            "items": {
              "type": "string"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "hasMore": {
                "type": "boolean"
              },
              "nextCursor": {
                "type": "string"
              }
            },
            "required": [
              "hasMore"
            ]
          }
        },
        "required": [
          "operations",
          "revision",
          "page"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "breeze_api_details",
      "description": "Read one Breeze ChMS API operation's request contract and refusal, including methods outside the call schemas. Reads no account data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET"
            ],
            "description": "The operation's HTTP method."
          },
          "path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2048,
            "description": "The path template from search, or a concrete path."
          },
          "param": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Return only this parameter, in full."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "page.nextCursor from the previous details call with the same method, path and param."
          }
        },
        "required": [
          "method",
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET"
            ]
          },
          "path": {
            "type": "string"
          },
          "operationId": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "refusal": {
            "type": "string",
            "description": "Reviewed refusal reason, separate from the pinned summary. Cut text is marked in truncated; details serves the complete text, paged if needed."
          },
          "server": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "description": "Path and query parameters."
          },
          "body": {
            "type": "object",
            "description": "Body content type and schema. When paged: this page's properties, the required names it delivers or chunks, and the schema's other keywords on the page that carries them."
          },
          "verdict": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "destructive",
              "refuse"
            ]
          },
          "tool": {
            "type": "string",
            "description": "The tool that calls it; absent when refused."
          },
          "named": {
            "type": "string",
            "description": "A named tool serving this operation with a projected result; prefer it."
          },
          "revision": {
            "type": "string"
          },
          "chunk": {
            "type": "object",
            "properties": {
              "of": {
                "type": "string",
                "description": "The piece this text belongs to, such as parameters.limit."
              },
              "text": {
                "type": "string",
                "description": "Part of that piece's JSON; join the parts in page order, then parse them."
              }
            },
            "required": [
              "of",
              "text"
            ]
          },
          "truncated": {
            "type": "array",
            "description": "Labels cut for size; their full text arrives as chunks.",
            "items": {
              "type": "string"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "hasMore": {
                "type": "boolean"
              },
              "nextCursor": {
                "type": "string"
              }
            },
            "required": [
              "hasMore"
            ],
            "description": "Present when the contract exceeds one answer: pass nextCursor back for the next pieces."
          }
        },
        "required": [
          "method",
          "path",
          "operationId",
          "summary",
          "parameters",
          "verdict",
          "revision"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "breeze_api_read",
      "description": "Call a reviewed Breeze ChMS API read. The operation index checks arguments before anything is sent. Breeze uses GET for writes too; only reviewed read endpoints are admitted. Calendar feeds and embed keys are removed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2048,
            "description": "Concrete path from search with ids filled in, e.g. /people/12345. No query string."
          },
          "query": {
            "type": "object",
            "description": "Query parameters as JSON, named as details lists them."
          },
          "fields": {
            "type": "array",
            "maxItems": 50,
            "description": "Dot paths to keep in data, applied to each item of an array, after value safety and privacy filtering.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "HTTP status."
          },
          "data": {
            "description": "Response body after value safety and the connection's privacy filtering."
          },
          "page": {
            "type": "object",
            "properties": {
              "hasMore": {
                "type": "boolean"
              },
              "nextCursor": {
                "type": "string"
              },
              "param": {
                "type": "string",
                "description": "Put nextCursor in this vendor parameter, unchanged."
              },
              "in": {
                "type": "string",
                "enum": [
                  "query",
                  "body"
                ]
              }
            },
            "required": [
              "hasMore",
              "param",
              "in"
            ]
          }
        },
        "required": [
          "status",
          "data"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "breeze_api_write",
      "description": "Call a reviewed Breeze ChMS API write; method and path are stated for approval, and the operation index checks arguments first. Breeze writes use GET query parameters. JSON parameters such as fields_json take serialized JSON strings.",
      "inputSchema": {
