    {
      "name": "list_events",
      "description": "List event instances between two dates with instance id, series id, calendar, and times. Breeze caches this list for up to 15 minutes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "First day, YYYY-MM-DD. Defaults to the first of this month."
          },
          "end": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "description": "Last day, YYYY-MM-DD. Defaults to the end of this month."
          },
          "calendarId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "maxLength": 20,
            "description": "Only events on this calendar from breeze_api_read /events/calendars/list."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Instances returned, 1 to Breeze's 1000. Defaults to 100.",
            "default": 100
          },
          "fields": {
            "type": "array",
            "maxItems": 50,
            "description": "Dot paths to keep in each event item.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Instance id."
                },
                "eventId": {
                  "type": "string",
                  "description": "Series id."
                },
                "name": {
                  "type": "string"
                },
                "calendarId": {
                  "type": "string"
                },
                "startsAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "endsAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "hasMore": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            },
            "required": [
