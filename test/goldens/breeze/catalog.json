                "eventId": {
                  "type": "string",
                  "description": "Series id."
                },
                "name": {
                  "type": "string"
                },
                "calendarId": {
                  "type": "string"
                },
                "startsAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "endsAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
