// nothing here names a real database or bucket, or deploys anywhere.
{
  "name": "connecta-artifacts-fixture",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "STORAGE_DB",
      "database_name": "connecta-artifacts-fixture",
      "database_id": "00000000-0000-4000-8000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS_BUCKET",
      "bucket_name": "connecta-artifacts-fixture"
    }
  ]
}
