{
  "name": "@zackbart/connecta-eve",
  "version": "0.35.0",
  "type": "module",
  "sideEffects": false,
  "description": "Eve connection and instructions helpers for Connecta agent endpoints.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackbart/connecta.git",
    "directory": "packages/connecta-eve"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "eve": ">=0.84.0 <0.85.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eve": "0.84.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "prepack": "pnpm run check",
    "probe:catalog": "node scripts/probe-catalog.mjs"
  }
}
