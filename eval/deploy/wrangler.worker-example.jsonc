// Local-only smoke config for the shipped Worker example (see worker-example.ts).
// Vars (PUBLIC_URL, secrets) arrive on the wrangler command line from
// eval/run-smoke.ts; D1 is wrangler's local simulation.
{
  "name": "connecta-eval-worker-example",
  "main": "worker-example.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "CONNECTA_DB", "database_name": "connecta-eval", "database_id": "00000000-0000-4000-8000-0000000000e1" }],
  "worker_loaders": [{ "binding": "LOADER" }]
}
