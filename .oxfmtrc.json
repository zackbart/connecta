{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "quoteProps": "preserve",
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "jsdoc": false,
  "ignorePatterns": [
    "**/*.generated.*",
    "src/auth/clerk-sdk/generated.ts",
    "src/operator-ui/generated.ts",
    "src/page-styles.ts",
    "src/version.ts",
    "bin/version.mjs",
    "src/providers/*/SKILL.md",
    "/package.json",
    "/knip.jsonc",
    "scripts/bundle-budget.json",
    "**/fixtures/**",
    "**/fixtures.ts",
    "**/__snapshots__/**",
    "**/*-snapshots/**",
    "eval/baselines/*.json",
    "**/package-lock.json",
    "**/npm-shrinkwrap.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "CHANGELOG.md"
  ]
}
