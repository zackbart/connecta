{
  "name": "@zackbart/connecta",
  "version": "0.37.1",
  "type": "module",
  "sideEffects": false,
  "description": "One MCP to rule them all — a single MCP endpoint aggregating many downstream connectors behind a code-first surface of six meta-tools.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.4.2",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "connecta": "./bin/connecta.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zackbart/connecta.git"
  },
  "homepage": "https://github.com/zackbart/connecta#readme",
  "bugs": {
    "url": "https://github.com/zackbart/connecta/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudflare-workers",
    "connectors"
  ],
  "files": [
    "bin",
    "dist",
    "documentation",
    "guides",
    "examples/worker",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "import": "./dist/d1.js"
    },
    "./json-schema": {
      "types": "./dist/json-schema.d.ts",
      "import": "./dist/json-schema.js"
    },
    "./quickjs": {
      "types": "./dist/executors/quickjs.d.ts",
      "import": "./dist/executors/quickjs.js"
    },
    "./auth/clerk": {
      "types": "./dist/auth/clerk.d.ts",
      "import": "./dist/auth/clerk.js"
    },
    "./auth/cloudflare-access": {
      "types": "./dist/auth/cloudflare-access.d.ts",
      "import": "./dist/auth/cloudflare-access.js"
    },
    "./providers/breeze": {
      "types": "./dist/providers/breeze/index.d.ts",
      "import": "./dist/providers/breeze/index.js"
    },
    "./providers/ccb": {
      "types": "./dist/providers/ccb/index.d.ts",
      "import": "./dist/providers/ccb/index.js"
    },
    "./providers/cloudflare": {
      "types": "./dist/providers/cloudflare/index.d.ts",
      "import": "./dist/providers/cloudflare/index.js"
    },
    "./providers/docs": {
      "types": "./dist/providers/docs/index.d.ts",
      "import": "./dist/providers/docs/index.js"
    },
    "./providers/drive": {
      "types": "./dist/providers/drive/index.d.ts",
      "import": "./dist/providers/drive/index.js"
    },
    "./providers/forms": {
      "types": "./dist/providers/forms/index.d.ts",
      "import": "./dist/providers/forms/index.js"
    },
    "./providers/github": {
      "types": "./dist/providers/github/index.d.ts",
      "import": "./dist/providers/github/index.js"
    },
    "./providers/gmail": {
      "types": "./dist/providers/gmail/index.d.ts",
      "import": "./dist/providers/gmail/index.js"
    },
    "./providers/granola": {
      "types": "./dist/providers/granola/index.d.ts",
      "import": "./dist/providers/granola/index.js"
    },
    "./providers/overflow": {
      "types": "./dist/providers/overflow/index.d.ts",
      "import": "./dist/providers/overflow/index.js"
    },
    "./providers/planning-center": {
      "types": "./dist/providers/planning-center/index.d.ts",
      "import": "./dist/providers/planning-center/index.js"
    },
    "./providers/quickbooks": {
      "types": "./dist/providers/quickbooks/index.d.ts",
      "import": "./dist/providers/quickbooks/index.js"
    },
    "./providers/sheets": {
      "types": "./dist/providers/sheets/index.d.ts",
      "import": "./dist/providers/sheets/index.js"
    },
    "./providers/slides": {
      "types": "./dist/providers/slides/index.d.ts",
      "import": "./dist/providers/slides/index.js"
    },
    "./providers/stripe": {
      "types": "./dist/providers/stripe/index.d.ts",
      "import": "./dist/providers/stripe/index.js"
    },
    "./providers/tithely": {
      "types": "./dist/providers/tithely/index.d.ts",
      "import": "./dist/providers/tithely/index.js"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel/index.d.ts",
      "import": "./dist/providers/vercel/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "import": "./dist/credentials.js"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "import": "./dist/activity.js"
    },
    "./auth/access-tokens": {
      "types": "./dist/access-tokens.d.ts",
      "import": "./dist/access-tokens.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./google": {
      "types": "./dist/google.d.ts",
      "import": "./dist/google.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:operator-ui": "node scripts/build-operator-ui.mjs",
    "check:operator-ui": "node scripts/build-operator-ui.mjs --check",
    "check:clerk-sdk": "node scripts/build-clerk-sdk.mjs --check",
    "build": "pnpm run providers:generate && pnpm run clean && tsc -p tsconfig.build.json && node scripts/prune-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.operator-ui.json --noEmit",
    "test": "vitest run",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test",
    "test:browser:snapshots": "node scripts/update-operator-snapshots.mjs",
    "pretest:browser:snapshots": "pnpm run build:operator-ui",
    "test:node": "vitest run --config vitest.config.node.ts",
    "test:workers": "vitest run --project workers",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:lint": "oxlint -D correctness --report-unused-disable-directives .",
    "check:unused": "knip --include dependencies,unlisted,exports,nsExports,types,nsTypes",
    "check:examples": "tsc -p tsconfig.template.node.json && tsc -p tsconfig.examples.worker.json",
    "check:security": "pnpm audit --prod --audit-level moderate",
    "check:package": "node scripts/check-package.mjs",
    "check:declarations": "node scripts/check-declarations.mjs --dist .",
    "check:bundle": "node scripts/bundle-size.mjs",
    "providers:check": "tsx scripts/drift-check.mjs --specs --manual",
    "eval:selftest": "tsx eval/selftest.ts",
    "eval:agent": "tsx eval/run-agent.ts",
    "eval:smoke": "tsx eval/run-smoke.ts",
    "eval:outcomes": "tsx eval/run-outcomes.ts",
    "preeval:outcomes": "node scripts/generate-version.mjs && pnpm run build:operator-ui",
    "eval:perf": "tsx eval/run-perf.ts",
    "eval:report": "tsx eval/report.ts",
    "check:static": "pnpm run format:check && pnpm run check:providers-generated && pnpm run check:docs && pnpm run check:changes && pnpm run check:operator-ui && pnpm run check:clerk-sdk && pnpm run check:lint && pnpm run check:unused && pnpm run typecheck",
    "check:build": "pnpm run build && pnpm run check:declarations && pnpm run check:bundle",
    "check:fast": "pnpm run check:static && vitest run --config vitest.config.node.ts --changed origin/main --passWithNoTests",
    "check": "pnpm run check:static && pnpm run test && pnpm run check:build",
    "release:check": "pnpm run release:check:core && pnpm run release:check:eve",
    "prepack": "pnpm run check",
    "check:changes": "node scripts/changelog.mjs --check && node --test scripts/changelog.test.mjs",
    "changelog:assemble": "node scripts/changelog.mjs",
    "providers:generate": "tsx scripts/generate-providers.mjs",
    "check:providers-generated": "tsx scripts/generate-providers.mjs --check",
    "prebuild": "node scripts/generate-version.mjs && pnpm run build:operator-ui",
    "pretest": "node scripts/generate-version.mjs && pnpm run build:operator-ui",
    "pretest:node": "node scripts/generate-version.mjs && pnpm run build:operator-ui",
    "pretest:workers": "node scripts/generate-version.mjs && pnpm run build:operator-ui",
    "pretest:browser": "pnpm run build:operator-ui",
    "pretypecheck": "node scripts/generate-version.mjs && pnpm run build:operator-ui",
    "precheck:bundle": "pnpm run build:operator-ui",
    "eval:regrade": "tsx eval/regrade.ts",
    "eval:compare": "tsx eval/compare.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "providers:spec": "tsx scripts/generate-openapi.mjs",
    "check:eve-package": "node scripts/check-eve-package.mjs",
    "release:check:core": "pnpm run check && pnpm run test:browser && pnpm run check:examples && pnpm run check:security && pnpm run check:package",
    "release:check:eve": "pnpm --filter @zackbart/connecta-eve run check && pnpm run check:eve-package && pnpm run check:security:eve",
    "check:security:eve": "pnpm --dir packages/connecta-eve audit --audit-level moderate"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "acorn": "^8.19.0",
    "effect": "4.0.5",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "@clerk/backend": "^3.12.0",
    "@cloudflare/codemode": "^0.4.4 || ^0.5.0",
    "quickjs-emscripten": "^0.32.0",
    "undici": "6.29.1"
  },
  "peerDependenciesMeta": {
    "@clerk/backend": {
      "optional": true
    },
    "@cloudflare/codemode": {
      "optional": true
    },
    "quickjs-emscripten": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clerk/backend": "3.12.0",
    "@cloudflare/codemode": "^0.5.0",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "5.20260804.1",
    "@effect/platform-node": "4.0.5",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-router": "^1.170.44",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alchemy": "2.0.0-beta.83",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.2",
    "knip": "^6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "^1.88.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "undici": "6.29.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
