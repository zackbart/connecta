    },
    "./providers/breeze": {
      "types": "./dist/providers/breeze/index.d.ts",
      "import": "./dist/providers/breeze/index.js"
    },
    "./providers/ccb": {
      "types": "./dist/providers/ccb/index.d.ts",
      "import": "./dist/providers/ccb/index.js"
    },
    "./providers/cloudflare": {
      "types": "./dist/providers/cloudflare/index.d.ts",
      "import": "./dist/providers/cloudflare/index.js"
    },
    "./providers/docs": {
      "types": "./dist/providers/docs/index.d.ts",
      "import": "./dist/providers/docs/index.js"
    },
    "./providers/drive": {
      "types": "./dist/providers/drive/index.d.ts",
      "import": "./dist/providers/drive/index.js"
    },
    "./providers/forms": {
      "types": "./dist/providers/forms/index.d.ts",
      "import": "./dist/providers/forms/index.js"
    },
    "./providers/github": {
      "types": "./dist/providers/github/index.d.ts",
