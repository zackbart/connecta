    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:operator-ui": "node scripts/build-operator-ui.mjs",
    "check:operator-ui": "node scripts/build-operator-ui.mjs --check",
    "check:clerk-sdk": "node scripts/build-clerk-sdk.mjs --check",
    "build": "npm run providers:generate && npm run clean && tsc -p tsconfig.build.json && node scripts/prune-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.operator-ui.json --noEmit",
    "test": "vitest run",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test",
    "test:node": "vitest run --project node",
    "test:workers": "vitest run --project workers",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:lint": "oxlint -D correctness --report-unused-disable-directives .",
    "check:unused": "knip --include dependencies,unlisted,exports,nsExports,types,nsTypes",
    "check:examples": "tsc -p tsconfig.template.node.json && tsc -p tsconfig.examples.worker.json",
    "check:security": "npm audit --omit=dev --audit-level=moderate",
    "check:package": "node scripts/check-package.mjs",
    "check:declarations": "node scripts/check-declarations.mjs --dist .",
    "check:bundle": "node scripts/bundle-size.mjs",
    "providers:check": "tsx scripts/drift-check.mjs --specs --docs",
    "drift:check": "tsx scripts/drift-check.mjs",
    "eval:selftest": "tsx eval/selftest.ts",
    "eval:agent": "tsx eval/run-agent.ts",
    "eval:smoke": "tsx eval/run-smoke.ts",
    "eval:perf": "tsx eval/run-perf.ts",
    "eval:report": "tsx eval/report.ts",
    "check:core": "npm run check:providers-generated && npm run check:docs && npm run check:changes && npm run check:operator-ui && npm run check:clerk-sdk && npm run check:lint && npm run check:unused && npm run typecheck && npm run test && npm run build && npm run check:declarations && npm run check:bundle && npm run check:examples",
    "check:fast": "node scripts/check-fast.mjs",
    "check": "npm run check:core && npm run test:browser",
    "release:check": "npm run check && npm run check:security && npm run check:package",
    "prepack": "npm run check",
    "check:changes": "node scripts/changelog.mjs --check && node scripts/check-node-suites.mjs && node --test scripts/changelog.test.mjs",
    "changelog:assemble": "node scripts/changelog.mjs",
    "providers:generate": "tsx scripts/generate-providers.mjs",
    "check:providers-generated": "tsx scripts/generate-providers.mjs --check",
    "prebuild": "node scripts/generate-version.mjs && npm run build:operator-ui",
    "pretest": "npm run build:operator-ui",
    "pretest:node": "npm run build:operator-ui",
    "pretest:workers": "npm run build:operator-ui",
    "pretest:browser": "npm run build:operator-ui",
    "pretypecheck": "npm run build:operator-ui",
    "precheck:bundle": "npm run build:operator-ui",
    "precheck:fast": "npm run check:operator-ui"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "acorn": "^8.19.0",
    "effect": "^4.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@clerk/backend": "^3.12.0",
    "@cloudflare/codemode": "^0.4.4 || ^0.5.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "peerDependenciesMeta": {
    "@clerk/backend": {
      "optional": true
    },
    "@cloudflare/codemode": {
      "optional": true
    },
    "quickjs-emscripten": {
      "optional": true
    }
  },
  "devDependencies": {
    "@clerk/backend": "3.12.0",
    "@cloudflare/codemode": "^0.5.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^4.20250101.0 || ^5.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.0",
    "knip": "^6.29.0",
    "oxlint": "^1.76.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.114.0"
  }
}
