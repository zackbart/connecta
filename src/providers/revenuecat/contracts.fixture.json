  "tools": [
    {
      "name": "validate-app-credentials",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 255,
            "description": "ID of the project"
          },
          "app_id": {
            "type": "string",
            "maxLength": 255,
            "description": "ID of the app"
          },
          "credential_type": {
            "type": "string",
            "enum": ["app_store_connect_key", "app_store_subscriptions_key", "google_play_service_account"],
            "description": "The saved credential set to validate."
          }
        },
        "required": ["project_id", "app_id", "credential_type"],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "preview-audience",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 255,
            "description": "ID of the project"
          },
          "sort_by": {
            "type": "string",
            "enum": ["status", "latest_auto_renew_intent", "first_seen_at", "last_seen_at", "total_spent"],
            "description": "Customer sample field to sort by."
          },
          "sort_direction": {
            "default": "asc",
            "type": "string",
            "enum": ["asc", "desc"],
            "description": "Direction to sort the customer sample."
          },
          "body": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "audience_uuid": {
                    "type": "string",
                    "description": "UUID of the saved Audience."
                  }
                },
                "required": ["audience_uuid"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "rules": {
                    "type": "object",
                    "properties": {
                      "groups": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "conditions": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "field": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "enum": [
                                          "country",
                                          "customerId",
                                          "status",
                                          "customerListExportStatus",
                                          "originalAppUserId",
                                          "platform",
                                          "storefront",
                                          "locale",
                                          "appVersion",
                                          "sdkVersion",
                                          "sdkFlavor",
                                          "platformVersion",
                                          "lastSeenAt",
                                          "firstSeenAt",
                                          "firstPurchaseAt",
                                          "mostRecentPurchaseAt",
                                          "mostRecentRenewalAt",
                                          "latestExpirationAt",
                                          "trialStartAt",
                                          "trialEndAt",
                                          "subscriptionOptOutAt",
                                          "trialOptOutAt",
                                          "totalRenewals",
                                          "totalSpent",
                                          "totalAdImpressions",
                                          "totalAdRevenue",
                                          "totalRewardedAdCompletions",
                                          "lastAdImpressionAt",
                                          "lastRewardedAdCompletionAt",
                                          "latestProduct",
                                          "latestOffer",
                                          "latestOfferType",
                                          "email",
                                          "displayName",
                                          "phoneNumber",
                                          "mediaSource",
                                          "campaign",
                                          "adGroup",
                                          "ad",
                                          "keyword",
                                          "creative",
                                          "idfa",
                                          "idfv",
                                          "gpsAdId",
                                          "priceExperimentId",
                                          "priceExperimentVariant",
                                          "hasActiveEntitlement",
                                          "activeEntitlements",
                                          "hasMadeSandboxPurchase",
                                          "hasMadeNonSubscriptionPurchase",
                                          "isRcPromo",
                                          "latestStore",
                                          "anyActiveStore",
                                          "latestStoreCountry",
                                          "latestOwnershipType",
                                          "latestPurchasedOffering",
                                          "latestAutoRenewIntent",
                                          "isCurrentlyTrialing",
                                          "latestEntitlements",
                                          "allPurchasedProductIds",
                                          "projectId",
                                          "projectName",
                                          "appConfigId",
                                          "lastSeenAppConfigId",
                                          "appConfigName",
                                          "appConfigStore"
                                        ]
                                      },
                                      {
                                        "type": "string",
                                        "pattern": "^customAttribute:[a-zA-Z][a-zA-Z0-9_-]*$",
                                        "description": "A custom subscriber attribute reference."
                                      }
                                    ]
                                  },
                                  "operator": {
                                    "type": "string",
                                    "enum": [
                                      "is",
                                      "isNot",
                                      "isAnyOf",
                                      "isNotAnyOf",
                                      "greaterThan",
                                      "greaterThanOrEqual",
                                      "lessThan",
                                      "lessThanOrEqual",
                                      "equal",
                                      "notEqual",
                                      "contains",
                                      "doesNotContain",
                                      "containsAnyOf",
                                      "before",
                                      "beforeOrOn",
                                      "on",
                                      "after",
                                      "afterOrOn",
                                      "within",
                                      "notWithin",
                                      "between",
                                      "notBetween",
                                      "isEmpty",
                                      "isNotEmpty"
                                    ],
                                    "description": "The comparison operator applied to the field."
                                  },
                                  "value": {
                                    "default": "",
                                    "type": "string",
                                    "description": "The value the field is compared against. May be empty for operators that do not take a value (e.g. `isEmpty`, `isNotEmpty`). Multi-value operators (`isAnyOf`, `isNotAnyOf`, `containsAnyOf`) take comma-separated values. For `latestProduct`, equality operators use product ids (`prod...`), while substring operators use raw product identifier text. For `anyActiveStore`, use store identifiers such as `app_store`."
                                  },
                                  "currency": {
                                    "type": "string",
                                    "enum": [
                                      "USD",
                                      "EUR",
                                      "GBP",
                                      "AUD",
                                      "CAD",
                                      "JPY",
                                      "BRL",
                                      "KRW",
                                      "CNY",
                                      "MXN",
                                      "SEK",
                                      "PLN",
                                      "NZD",
                                      "CHF"
                                    ],
                                    "description": "Currency for a `totalSpent` or `totalAdRevenue` comparison. Omitted values are interpreted as USD. Must be omitted for `isEmpty` and `isNotEmpty`."
                                  }
                                },
                                "required": ["field", "operator"],
                                "additionalProperties": false,
                                "description": "A single Audience rule condition."
                              },
                              "description": "The conditions in the group, combined with AND."
                            }
                          },
                          "required": ["conditions"],
                          "additionalProperties": false
                        },
                        "description": "The condition groups, combined with OR."
                      }
                    },
                    "required": ["groups"],
                    "additionalProperties": false,
                    "description": "The Audience membership rules. A subscriber matches the Audience when any group matches (groups are combined with OR); within a group all conditions must match (conditions are combined with AND)."
                  }
                },
                "required": ["rules"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["project_id", "body"],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "render-paywall-screenshot",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the project"
          },
          "paywall_id": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the paywall"
          },
          "version": {
            "default": "draft",
            "description": "Which paywall version to render. Defaults to draft; falls back to the other version when the requested one is empty.",
            "type": "string",
            "enum": ["draft", "published"]
          },
          "color_scheme": {
            "default": "light",
            "description": "Color scheme to emulate. Defaults to light.",
            "type": "string",
            "enum": ["light", "dark"]
          },
          "offer": {
            "default": "none",
            "description": "Which offer state to preview. `none` is the screen for a customer who is not eligible for a trial or intro offer. `introductory` is the screen for a customer who is (free trial or paid intro). Defaults to none.",
            "type": "string",
            "enum": ["none", "introductory"]
          }
        },
        "required": ["project_id", "paywall_id"],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list-app-subscription-groups",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "maxLength": 255,
            "description": "ID of the project"
          },
          "app_id": {
            "type": "string",
            "maxLength": 255,
            "description": "ID of the app"
          }
        },
        "required": ["project_id", "app_id"],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ],
  "references": [
    "https://www.revenuecat.com/docs/tools/mcp/tools-reference.md",
    "https://www.revenuecat.com/docs/api-v2/audience",
    "https://www.revenuecat.com/docs/api-v2/app"
  ]
}
