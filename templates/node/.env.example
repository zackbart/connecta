# Client/doctor credential only. Provision a stored cta_ token with the trusted
# local command in README.md. This variable never configures server auth and
# is not passed to the container. An empty database refuses all machine clients.
CONNECTA_TOKEN=

# Optional. Defaults to 8787. Compose publishes this port on the host too.
PORT=8787

# Optional. The origin this deployment answers on, once it answers on more
# than this machine: downstream OAuth calls back to
# <PUBLIC_URL>/oauth/callback/<connectorId>. Defaults to http://localhost:<PORT>.
PUBLIC_URL=

# Optional. The one SQLite file that holds every piece of state: downstream
# OAuth grants, sealed credentials, catalogs, access tokens, and activity.
# Defaults to ./.connecta.sqlite locally and /data/connecta.sqlite in the
# container — keep the container path under /data so state lands on the named
# volume and survives a rebuild.
CONNECTA_DATABASE=

# --- Optional modules ---------------------------------------------------
# Each switches on the matching module in src/connecta.config.ts when set and
# leaves it off when empty. Nothing here needs a source edit.

# Operator sign-in with Clerk. Set both, or neither. Only a signed-in operator
# may write a credential; machine access tokens grant no interactive authority.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Credential vault. Base64-encoded 32-byte AES key encrypting the values an
# operator saves inside a connection on /. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# Keep it here or in a secret store — never in the database it protects, and
# never in source control. Losing it makes stored credentials unreadable.
CONNECTA_CREDENTIAL_KEY=

# Payload-free activity history at /activity, in the database above. Set to
# "on". Rows older than 90 days are pruned as new ones are written; change
# `retentionDays` in src/connecta.config.ts to keep more or less.
CONNECTA_ACTIVITY=

