{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/node.ts",
    "src/json-schema.ts",
    "src/executors/quickjs.ts",
    "src/executors/quickjs-child.ts",
    "src/auth/clerk.ts",
    "src/artifacts.ts",
    "src/providers/cloudflare.ts",
    "src/providers/linear.ts",
    "src/providers/mixpanel.ts",
    "src/providers/notion.ts",
    "src/providers/revenuecat.ts",
    "src/providers/stripe.ts",
    "src/providers/vercel.ts",
    "src/operator-ui/app/main.tsx",
    "examples/*/src/index.ts",
    "scripts/*.mjs",
    "test/**/*.test.ts",
    // The eval harness: CLI entries, plus the Worker entries wrangler loads.
    "eval/*.ts",
    "eval/deploy/worker-*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/**/*.ts",
    "scripts/**/*.mjs",
    "test/**/*.ts",
    "eval/**/*.ts",
    "*.ts"
  ],
  "ignoreDependencies": [
    // `tsx` needed an exemption until `drift:check` named it in a script: its
    // other uses — the forked QuickJS child, the Node template's runner — are
    // ones knip cannot see. Delete that script and it needs the exemption back.
    // `wrangler` — the deployment CLI and the schema provider for
    // examples/worker/wrangler.jsonc — is in the same position:
    // test/d1-storage-example.test.ts imports it, and losing that import
    // brings its exemption back.
  ]
}
